      "parameters": {
        "jsCode": "const hasMatch = $input.all().some(item => /\\.(rar|zip|r01)$/.test(item.json.name));\n\nreturn $input.all().map(item => ({\n  ...item,\n  json: {\n    ...item.json,\n    hasMatch: hasMatch\n  }\n}));"
